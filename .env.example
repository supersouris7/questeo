# Copier en .env (jamais versionné) et compléter. Toutes les variables :
# docs/operations/configuration.md

# Mot de passe PostgreSQL (obligatoire) : `openssl rand -hex 24`
POSTGRES_PASSWORD=

# URL publique (QR code de connexion des appareils), ex. https://epicademie.exemple.fr
PUBLIC_URL=

# Port exposé sur la machine hôte
EPICADEMIE_PORT=3000

# Nombre de proxys de confiance devant le serveur (nginx : 1)
TRUST_PROXY=0

# Jeton exigé par /api/metrics (vide : métriques ouvertes, à réserver au réseau interne)
METRICS_TOKEN=

# Administration (32 caractères min., générer : openssl rand -base64 36). Le frontal de la page de
# pilotage l'envoie dans l'en-tête X-Epicademie-Operateur ; vide : aucune administration.
ADMIN_OPERATOR_SECRET=
# Connexion de l'équipe par OpenID Connect (docs/adr/0036) : les quatre ensemble, sinon rien.
# Configurée, elle remplace ADMIN_OPERATOR_SECRET.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_ORIGIN=
# Accès de secours (32 caractères min.) : à laisser vide hors panne du fournisseur.
ADMIN_SECOURS_SECRET=

# E-mails (validation d'adresse) : Brevo, API transactionnelle. Obligatoire en production.
# Sans clé : simulation (lien journalisé) — jamais en production ; recette : APP_ENV=recette.
APP_ENV=
# Portail de connexion placé devant la plateforme : page de déconnexion HTTPS, ouverte après
# « Se déconnecter » (facultatif).
PORTAL_LOGOUT_URL=
# Recette uniquement (APP_ENV=recette, TRUST_PROXY=1) : le compte authentifié par le portail
# (en-tête Remote-Email posé par le proxy) est ouvert directement. Vide : désactivé.
PORTAL_LOGIN=
BREVO_API_KEY=
MAIL_FROM=

# « Continuer avec Google » (facultatif : bouton masqué si vide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Par défaut : PUBLIC_URL + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
